# Machine-/site-specific configuration.
# Copy this file to `sdkconfig.secrets` and fill in real values:
#   cp sdkconfig.secrets.template sdkconfig.secrets
# `sdkconfig.secrets` is gitignored and loaded on top of `sdkconfig.defaults`.

CONFIG_ESP_WIFI_SSID="my-network"
CONFIG_ESP_WIFI_PASSWORD="my-password"
CONFIG_MQTT_BROKER_URI="mqtt://192.168.1.10:1883"
